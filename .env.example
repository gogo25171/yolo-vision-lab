# Copier en .env puis adapter :  cp .env.example .env
# Toutes les variables sont optionnelles ; la ligne de commande a la priorité.

# --- Source & mode -----------------------------------------------------------
# Fichier vidéo/image, URL (rtsp://, http://...) ou index de webcam (0, 1...)
SOURCE=samples/videos/street_ljubljana.mp4
# fast = temps réel (CCTV/webcam) | accurate = vidéo enregistrée, précision maximale
MODE=fast

# --- Modèle ------------------------------------------------------------------
# Vide = préréglage du mode (fast : yolo26s / yolo26n sans GPU, accurate : yolo26x).
# Accepte aussi un modèle exporté : models/yolo26s.engine (TensorRT), .onnx, _openvino_model/
MODEL=
MODELS_DIR=models
# Taille d'entrée (vide = 640 en fast, 1280 en accurate)
IMGSZ=
CONF=0.35
# Vide = auto (GPU 0 si disponible). Ex. : cpu, 0, 1
DEVICE=
# FP16 sur GPU (vide = auto)
HALF=
# bytetrack.yaml (rapide) | botsort.yaml (plus robuste) ; vide = préréglage
TRACKER=

# Vocabulaire ouvert (YOLOE) : décrire les classes en texte, hauteur optionnelle en m.
# Nécessite : pip install git+https://github.com/ultralytics/CLIP.git
# OPEN_VOCAB_CLASSES=person:1.7,child:1.2,dog:0.55,stroller:1.0,scooter
OPEN_VOCAB_CLASSES=

# --- Mesures -----------------------------------------------------------------
# Champ de vision horizontal de la caméra (degrés) -> focale. Webcam ~70, CCTV 2.8 mm ~100.
CAMERA_HFOV_DEG=70
# Ou focale en pixels mesurée (prioritaire sur le FOV)
FOCAL_LENGTH_PX=
# Homographie sol (4 points image -> mètres) pour une vitesse fiable : voir docs/mesures.md
CALIBRATION_FILE=
SPEED_WINDOW_S=1.0

# --- Plaques d'immatriculation -------------------------------------------------
PLATES_ENABLED=true
PLATE_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end
PLATE_OCR_MODEL=cct-s-v2-global-model
# Formats testés quand l'OCR ne reconnaît pas le pays (voir projets/distance_vitesse/plate_formats.py)
PLATE_COUNTRIES=France
# cpu (recommandé) | cuda (nécessite onnxruntime-gpu compatible avec votre CUDA)
PLATE_DEVICE=cpu
# Tentative de lecture toutes les N images par véhicule (vide = préréglage : 15 / 3)
PLATE_EVERY=
PLATE_MIN_VEHICLE_PX=80

# --- Zones de comptage -----------------------------------------------------------
# Fichier JSON de zones/lignes (éditeur : python -m vision_lab zones <source>)
ZONES_FILE=

# --- Sortie -------------------------------------------------------------------
# window (fenêtre OpenCV) | web (http://localhost:WEB_PORT) | none (headless)
VIEW=window
# auto | full | compact
LABELS=auto
WEB_HOST=0.0.0.0
WEB_PORT=8080
OUTPUT_DIR=output
# Enregistrer la vidéo annotée (vide = préréglage : non en fast, oui en accurate)
SAVE_VIDEO=
# Flux live : ne traiter que l'image la plus récente (vide = préréglage)
DROP_FRAMES=

# Fins de ligne normalisées
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Médias des échantillons : Git LFS
samples/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
samples/**/*.webm filter=lfs diff=lfs merge=lfs -text
samples/**/*.png filter=lfs diff=lfs merge=lfs -text
samples/**/*.jpg filter=lfs diff=lfs merge=lfs -text
